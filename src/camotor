# =========================
# FSM System
# =========================
class CoffeeSystemFSM:
    def __init__(self):
        self.state = State.IDLE
        self.state_t0 = time.time()

        # timing / tuning
        self.feed_pulse_ms = 250
        self.settle_s = 0.6
        self.led_warmup_s = 0.15

        # decision memory
        self.beans = 0
        self.rocks = 0
        self.decision = "NONE"

        # init LED
        leds_init_once()
        leds_off()

        # load model
        self.model = load_model(MODEL_FILE)
        if self.model is None:
            raise RuntimeError("Model not loaded.")

        # init camera
        self.picam2 = Picamera2()
        config = self.picam2.create_preview_configuration(
            main={"format": "RGB888", "size": (FRAME_W, FRAME_H)}
        )
        self.picam2.configure(config)
        self.picam2.start()
        time.sleep(1.5)
        try:
            self.picam2.set_controls({"AeEnable": False, "AwbEnable": False})
        except Exception:
            pass

        # ROI + background
        self.roi_rect = clamp_roi(ROI_X, ROI_Y, ROI_W, ROI_H, FRAME_W, FRAME_H)

        # Capture background once at startup (IMPORTANT: ROI should be empty)
        print("[CV] Capturing background (ensure ROI is empty)...")
        leds_white_on()
        time.sleep(self.led_warmup_s)
        self.bg_gray = capture_background_gray(self.picam2, self.roi_rect, n=20)
        print("[CV] Background captured.")
        leds_off()

    def enter(self, new_state: State):
        self.state = new_state
        self.state_t0 = time.time()
        print(f"[FSM] -> {new_state.name}")

    def elapsed(self) -> float:
        return time.time() - self.state_t0

    def shutdown(self):
        try:
            leds_off()
        except Exception:
            pass
        try:
            self.picam2.stop()
        except Exception:
            pass

    def tick(self):
        try:
            if self.state == State.IDLE:
                if user_start():
                    self.enter(State.FEED_PULSE)

            elif self.state == State.FEED_PULSE:
                steppers_enable_all()
                feeder_pulse(self.feed_pulse_ms)
                self.enter(State.STEPPERS_OFF)

            elif self.state == State.STEPPERS_OFF:
                # MUST disable motors before vision
                steppers_disable_all()
                self.enter(State.SETTLE)

            elif self.state == State.SETTLE:
                # Wait vibration decay
                if self.elapsed() >= self.settle_s:
                    self.enter(State.LIGHT_ON)

            elif self.state == State.LIGHT_ON:
                # ===== LIGHT_ON + CAPTURE + DETECT (your request) =====
                leds_white_on()
                if self.elapsed() < self.led_warmup_s:
                    return  # keep waiting in LIGHT_ON

                self.beans, self.rocks, self.decision = detect_once(
                    self.picam2, self.model, self.roi_rect, self.bg_gray
                )
                print(f"[CV] beans={self.beans} rocks={self.rocks} => decision={self.decision}")

                leds_off()
                self.enter(State.SORT)

            elif self.state == State.SORT:
                # Sorting may vibrate -> do it AFTER detection
                steppers_enable_all()
                flip_plane_move(self.decision)
                self.enter(State.WEIGH_CHECK)

            elif self.state == State.WEIGH_CHECK:
                w = read_weight_g()
                print(f"[SCALE] {w:.2f} g")

                # TODO: replace with your real logic:
                # if w < target -> FEED_PULSE else -> ARM_PICK
                self.enter(State.ARM_PICK)

            elif self.state == State.ARM_PICK:
                steppers_disable_all()
                arm_pick()
                self.enter(State.DELIVER)

            elif self.state == State.DELIVER:
                arm_deliver()
                self.enter(State.DONE)

            elif self.state == State.DONE:
                print("[FSM] DONE -> IDLE")
                self.enter(State.IDLE)

            elif self.state == State.ERROR:
                steppers_disable_all()
                leds_off()
                time.sleep(0.5)

        except Exception as e:
            print("[FSM] Exception:", e)
            self.enter(State.ERROR)

def main():
    fsm = CoffeeSystemFSM()
    try:
        while True:
            fsm.tick()
            time.sleep(0.02)
    except KeyboardInterrupt:
        print("\nStopping...")
    finally:
        fsm.shutdown()

if __name__ == "__main__":
    main()
